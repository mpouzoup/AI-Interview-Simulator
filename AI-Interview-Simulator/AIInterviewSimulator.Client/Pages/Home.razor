@page "/"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

@using System.Diagnostics

@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Interview Simulator</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-6">

    @if (!isSessionStarted)
    {
        <MudCard Elevation="4" Class="pa-6 rounded-lg">
            <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true" Style="font-weight:700; color:#1e293b;">
                Προσομοίωση Συνέντευξης Εργασίας
            </MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6" Style="color:#64748b;">
                Παρακαλούμε συμπληρώστε τα παρακάτω στοιχεία για να ξεκινήσει η διαδικασία (7 στάδια).
            </MudText>
            
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined"
                      Class="mb-6"
                      Style="border-radius: 8px;">

                <MudText Typo="Typo.subtitle2" Style="font-weight:700;" Class="mb-2">
                    Πώς λειτουργεί η προσομοίωση
                </MudText>

                <MudText Typo="Typo.body2">
                    Η προσομοίωση αποτελείται από 7 στάδια συνέντευξης εργασίας.
                    Σε κάθε στάδιο θα σας παρουσιάζεται μία ερώτηση και, αφού υποβάλετε
                    την απάντησή σας, θα λαμβάνετε ανατροφοδότηση από το σύστημα σχετικά
                    με την απάντησή σας.
                    Στη συνέχεια μπορείτε είτε να βελτιώσετε την απάντησή σας είτε
                    να συνεχίσετε στην επόμενη ερώτηση.
                    Απαντήστε όπως θα απαντούσατε σε μια πραγματική συνέντευξη εργασίας.
                </MudText>
                
                <MudText Typo="Typo.caption"
                         Style="color:#64748b;"
                         Class="mt-3">
                    Η ανατροφοδότηση παρέχεται για σκοπούς εξάσκησης και αυτοβελτίωσης
                    και δεν αποτελεί επίσημη ή αντικειμενική αξιολόγηση επαγγελματικής καταλληλότητας.
                </MudText>

            </MudAlert>

            <MudForm @ref="form">
                <MudTextField @bind-Value="nickname" Label="Ψευδώνυμο / Nickname" Required="true" Variant="Variant.Outlined" Class="mb-4" />
                
                <MudNumericField @bind-Value="age" Label="Ηλικία" Required="true" Min="18" Max="99" Variant="Variant.Outlined" Class="mb-4" />

                <MudSelect @bind-Value="gender" Label="Φύλο" Required="true" Variant="Variant.Outlined" Class="mb-4">
                    <MudSelectItem Value="@("Male")">Άνδρας</MudSelectItem>
                    <MudSelectItem Value="@("Female")">Γυναίκα</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Άλλο / Προτιμώ να μην πω</MudSelectItem>
                </MudSelect>

                <MudSelect @bind-Value="aiFamiliarity" Label="Εξοικείωση με την Τεχνητή Νοημοσύνη (AI)" Required="true" Variant="Variant.Outlined" Class="mb-6">
                    <MudSelectItem Value="@("Low")">Χαμηλή</MudSelectItem>
                    <MudSelectItem Value="@("Medium")">Μεσαία</MudSelectItem>
                    <MudSelectItem Value="@("High")">Υψηλή</MudSelectItem>
                </MudSelect>
                
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" OnClick="StartInterview" Disabled="@(string.IsNullOrWhiteSpace(nickname) || isLoading)" Style="border-radius: 8px; font-weight:600; text-transform:none; height: 50px;">
                    @if (isLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">Έναρξη...</MudText>
                    }
                    else
                    {
                        <MudText>Έναρξη Συνέντευξης</MudText>
                    }
                </MudButton>
            </MudForm>
        </MudCard>
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-4 mb-4 rounded-lg" Style="background-color: #f8fafc;">
            <div style="display:flex; justify-content:space-between; align-items:center;" class="mb-2">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #0f172a;">
                    Στάδιο @currentStage από 7
                </MudText>
            </div>
            <MudProgressLinear Color="Color.Primary" Value="@((currentStage / 7.0) * 100)" Class="rounded" Size="Size.Medium" />
        </MudPaper>

        <MudPaper Elevation="2" id="chat-container" Style="height: 500px; overflow-y: auto; padding: 20px; background-color: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0;">
            <div style="display: flex; flex-direction: column; gap: 16px;">
                @foreach (var msg in chatMessages)
                {
                    var isUser = msg.IsUser;
                    <div style="display: flex; justify-content: @(isUser ? "flex-end" : "flex-start"); gap: 10px;">
                        @if (!isUser)
                        {
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" />
                            </MudAvatar>
                        }

                        <div style="background-color: @(isUser ? "#2563eb" : "#f1f5f9"); 
                                    color: @(isUser ? "#ffffff" : "#0f172a"); 
                                    padding: 14px 18px; 
                                    border-radius: 16px; 
                                    max-width: 75%; 
                                    font-size: 15px; 
                                    line-height: 1.6;
                                    box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                            <span style="font-weight: 700; display: block; margin-bottom: 4px; font-size: 11px; color: @(isUser ? "#bfdbfe" : "#64748b"); text-transform: uppercase;">
                                @(isUser ? nickname : "ΣΥΝΕΝΤΕΥΚΤΗΣ")
                            </span>
                            @msg.Text
                        </div>

                        @if (isUser)
                        {
                            <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            </MudAvatar>
                        }
                    </div>
                }

                @if (isBotTyping)
                {
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" />
                        </MudAvatar>
                        <MudText Typo="Typo.body2" Style="color: #64748b; font-style: italic;">
                            Ο συνεντεύκτης πληκτρολογεί...
                        </MudText>
                    </div>
                }
            </div>
        </MudPaper>

        <div Class="mt-4" style="display: flex; gap: 12px;">
            @if (interviewState == InterviewUiState.Answering)
            {
                <MudTextField @bind-Value="userInput"
                              Label="Γράψτε την απάντησή σας..."
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Lines="3"
                              Disabled="@isBotTyping"
                              @onkeydown="HandleKeyDown" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SendMessage"
                           Disabled="@(string.IsNullOrWhiteSpace(userInput) || isBotTyping)">
                    Αποστολή
                </MudButton>
            }
            @if (interviewState == InterviewUiState.WaitingForDecision)
            {
                <MudStack Spacing="2" Class="mt-4">

                    <MudText Typo="Typo.body2"
                             Align="Align.Center"
                             Style="color:#64748b;">
                        Αφού διαβάσετε την ανατροφοδότηση, επιλέξτε αν θέλετε
                        να βελτιώσετε την απάντησή σας ή να συνεχίσετε στην επόμενη ερώτηση.
                    </MudText>

                    <MudStack Row="true"
                              Spacing="2"
                              Justify="Justify.Center">

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="ChooseRevision"
                                   Disabled="@isActionLoading">
                            Βελτίωση απάντησης
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="ContinueWithoutRevision"
                                   Disabled="@isActionLoading">
                            Συνέχεια στην επόμενη ερώτηση
                        </MudButton>

                    </MudStack>

                </MudStack>
            }
            
            @if (interviewState == InterviewUiState.Revising)
            {
                <MudStack Spacing="2" Class="w-100">

                    <MudText Typo="Typo.subtitle2" Style="color:#475569;">
                        Βελτιώστε την απάντησή σας με βάση το feedback που λάβατε.
                    </MudText>

                    <MudTextField @bind-Value="userInput"
                                  Label="Βελτιωμένη απάντηση"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Lines="4" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SubmitRevision"
                               Disabled="@(string.IsNullOrWhiteSpace(userInput) || isActionLoading)">
                        Υποβολή βελτιωμένης απάντησης
                    </MudButton>

                </MudStack>
            }

            @if (interviewState == InterviewUiState.Finished)
            {
                <MudAlert Severity="Severity.Success"
                          Variant="Variant.Filled"
                          Class="w-100"
                          Style="border-radius: 8px;">
                    🎉 Η προσομοίωση συνέντευξης ολοκληρώθηκε!
                    Σας ευχαριστούμε θερμά για τη συμμετοχή σας.
                </MudAlert>
            }
        </div>
    }

</MudContainer>

@code {
    private const string ApiBaseUrl = "api/Interview";

    private MudForm form = null!;
    private bool isLoading = false;
    private bool isActionLoading = false;

    private string nickname = "";
    private int age = 24;
    private string gender = "Male";
    private string aiFamiliarity = "Medium";
    private string selectedCondition = "A";

    private bool isSessionStarted = false;
    private int userId;
    private Guid sessionId;
    private int currentStage = 1;
    private string currentQuestionText = "";

    private string userInput = "";
    private bool isBotTyping = false;
    private List<ChatMessage> chatMessages = new();

    private Stopwatch latencyStopwatch = new();
    
    private int currentAnswerId;
    
    private enum InterviewUiState
    {
        Answering,
        WaitingForDecision,
        Revising,
        Finished
    }

    private InterviewUiState interviewState =
        InterviewUiState.Answering;

    private QuestionResponseDto? pendingQuestion;

    private string originalAnswerText = "";
    private DateTime currentQuestionShownAt;

    private async Task StartInterview()
    {
        if (string.IsNullOrWhiteSpace(nickname))
            return;

        isLoading = true;

        try
        {
            var userRequest = new
            {
                nickname,
                age,
                gender,
                aiFamiliarityLevel = aiFamiliarity
            };

            var userResponse = await Http.PostAsJsonAsync(
                $"{ApiBaseUrl}/users",
                userRequest);

            userResponse.EnsureSuccessStatusCode();

            var user = await userResponse.Content
                .ReadFromJsonAsync<UserDto>();

            if (user == null)
                return;

            userId = user.Id;

            var sessionRequest = new
            {
                userId
            };

            var sessionResponse = await Http.PostAsJsonAsync(
                $"{ApiBaseUrl}/sessions",
                sessionRequest);

            sessionResponse.EnsureSuccessStatusCode();

            var session = await sessionResponse.Content
                .ReadFromJsonAsync<SessionDto>();

            if (session == null)
                return;

            sessionId = session.Id;
            selectedCondition = session.Condition;
            isSessionStarted = true;

            await GetNextQuestionFromApi();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting interview: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GetNextQuestionFromApi()
    {
        isBotTyping = true;
        StateHasChanged();

        try
        {
            var res = await Http.GetFromJsonAsync<QuestionResponseDto>(
                $"{ApiBaseUrl}/sessions/{sessionId}/next-question");

            if (res == null)
                return;

            if (res.IsFinished)
            {
                interviewState = InterviewUiState.Finished;
                return;
            }

            if (string.IsNullOrWhiteSpace(res.Feedback))
            {
                ShowQuestion(res);
                return;
            }

            chatMessages.Add(new ChatMessage
            {
                Text = res.Feedback,
                IsUser = false
            });

            pendingQuestion = res;

            interviewState = InterviewUiState.WaitingForDecision;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching question: {ex.Message}");
        }
        finally
        {
            isBotTyping = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }
    
    private void ShowQuestion(QuestionResponseDto question)
    {
        currentStage = question.StageNumber;
        currentQuestionText = question.QuestionText;
        currentQuestionShownAt = DateTime.UtcNow;
        
        chatMessages.Add(new ChatMessage
        {
            Text = question.QuestionText,
            IsUser = false
        });

        latencyStopwatch.Restart();

        interviewState = InterviewUiState.Answering;
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isBotTyping) return;

        latencyStopwatch.Stop();
        
        var userText = userInput;
        userInput = "";

        chatMessages.Add(new ChatMessage { Text = userText, IsUser = true });
        await ScrollToBottom();

        var answerReq = new
        {
            sessionId,
            stageNumber = currentStage,
            stageName = GetStageName(currentStage),
            questionText = currentQuestionText,
            answerText = userText,
            questionShownAt = currentQuestionShownAt
        };
        
        try
        {
            var answerResponse = await Http.PostAsJsonAsync(
                $"{ApiBaseUrl}/answers",
                answerReq);

            answerResponse.EnsureSuccessStatusCode();

            var savedAnswer = await answerResponse.Content
                .ReadFromJsonAsync<AnswerResponseDto>();

            if (savedAnswer == null)
            {
                return;
            }

            currentAnswerId = savedAnswer.AnswerId;
            originalAnswerText = userText;        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving answer: {ex.Message}");
        }

        await GetNextQuestionFromApi();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(userInput) && !isBotTyping && !isActionLoading)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync("eval", "var el = document.getElementById('chat-container'); if(el) { el.scrollTop = el.scrollHeight; }");
    }
    
    private static string GetStageName(int stageNumber)
    {
        return stageNumber switch
        {
            1 => "Αυτοπαρουσίαση και πρώτη εντύπωση",
            2 => "Κίνητρα για τη θέση και την εταιρεία",
            3 => "Αυτοαξιολόγηση ικανοτήτων",
            4 => "Συνεργασία και ομαδικότητα",
            5 => "Διαχείριση δύσκολων καταστάσεων",
            6 => "Αποτυχία και προσαρμοστικότητα",
            7 => "Επαγγελματικοί στόχοι και εξέλιξη",
            _ => "Άγνωστο στάδιο"
        };
    }
    
    private async Task ChooseRevision()
    {
        if (currentAnswerId <= 0 || pendingQuestion == null)
            return;

        isActionLoading = true;
        try
        {
            var decisionRequest = new
            {
                choseToRevise = true
            };

            var response = await Http.PutAsJsonAsync(
                $"{ApiBaseUrl}/answers/{currentAnswerId}/decision",
                decisionRequest);

            response.EnsureSuccessStatusCode();

            userInput = originalAnswerText;
            interviewState = InterviewUiState.Revising;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error choosing revision: {ex.Message}");
        }
        finally
        {
            isActionLoading = false;
            StateHasChanged();
        }
    }

    private async Task ContinueWithoutRevision()
    {
        if (currentAnswerId <= 0 || pendingQuestion == null)
            return;

        isActionLoading = true;
        try
        {
            var decisionRequest = new
            {
                choseToRevise = false
            };

            var response = await Http.PutAsJsonAsync(
                $"{ApiBaseUrl}/answers/{currentAnswerId}/decision",
                decisionRequest);

            response.EnsureSuccessStatusCode();

            var nextQuestion = pendingQuestion;
            pendingQuestion = null;

            if (nextQuestion != null && !string.IsNullOrWhiteSpace(nextQuestion.QuestionText))
            {
                ShowQuestion(nextQuestion);
            }
            else
            {
                interviewState = InterviewUiState.Finished;
            }

            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving decision: {ex.Message}");
        }
        finally
        {
            isActionLoading = false;
            StateHasChanged();
        }
    }
    
    private async Task SubmitRevision()
    {
        if (currentAnswerId <= 0 ||
            pendingQuestion == null ||
            string.IsNullOrWhiteSpace(userInput))
        {
            return;
        }

        isActionLoading = true;
        try
        {
            var revisedText = userInput.Trim();

            var revisionRequest = new
            {
                revisedAnswerText = revisedText
            };

            var response = await Http.PutAsJsonAsync(
                $"{ApiBaseUrl}/answers/{currentAnswerId}/revision",
                revisionRequest);

            response.EnsureSuccessStatusCode();

            chatMessages.Add(new ChatMessage
            {
                Text = revisedText,
                IsUser = true
            });

            userInput = "";

            var nextQuestion = pendingQuestion;
            pendingQuestion = null;

            if (nextQuestion != null && !string.IsNullOrWhiteSpace(nextQuestion.QuestionText))
            {
                ShowQuestion(nextQuestion);
            }
            else
            {
                interviewState = InterviewUiState.Finished;
            }

            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting revision: {ex.Message}");
        }
        finally
        {
            isActionLoading = false;
            StateHasChanged();
        }
    }
}