@page "/"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

@using System.Diagnostics

@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Interview Simulator</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-6">
    @if (studyInfo.TestMode)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            ΤΟΠΙΚΗ ΔΟΚΙΜΗ — μόνο επινοημένα δεδομένα, ξεχωριστή βάση, χωρίς πραγματική έρευνα.
            Condition B: stub χωρίς Gemini ή χρέωση.
            @if (isSessionStarted) { <strong>Τρέχουσα συνθήκη: @selectedCondition</strong> }
        </MudAlert>
    }

    @if (!isSessionStarted)
    {
        <MudCard Elevation="4" Class="pa-6 rounded-lg">
            <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true" Style="font-weight:700; color:#1e293b;">
                Προσομοίωση Συνέντευξης Εργασίας
            </MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6" Style="color:#64748b;">
                Παρακαλούμε συμπληρώστε τα παρακάτω στοιχεία για να ξεκινήσει η διαδικασία (7 στάδια).
            </MudText>
            
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined"
                      Class="mb-6"
                      Style="border-radius: 8px;">

                <MudText Typo="Typo.subtitle2" Style="font-weight:700;" Class="mb-2">
                    Πώς λειτουργεί η προσομοίωση
                </MudText>

                <MudText Typo="Typo.body2">
                    Η προσομοίωση αποτελείται από 7 στάδια συνέντευξης εργασίας.
                    Σε κάθε στάδιο θα σας παρουσιάζεται μία ερώτηση και, αφού υποβάλετε
                    την απάντησή σας, θα λαμβάνετε ανατροφοδότηση από το σύστημα σχετικά
                    με την απάντησή σας.
                    Στη συνέχεια μπορείτε είτε να βελτιώσετε την απάντησή σας είτε
                    να συνεχίσετε στην επόμενη ερώτηση.
                    Επιτρέπεται μία προαιρετική αναθεώρηση ανά ερώτηση. Μετά την αναθεώρηση
                    θα λάβετε νέα ανατροφοδότηση και θα επιλέξετε μόνο «Συνέχεια».
                    Απαντήστε όπως θα απαντούσατε σε μια πραγματική συνέντευξη εργασίας.
                </MudText>
                
                <MudText Typo="Typo.caption"
                         Style="color:#64748b;"
                         Class="mt-3">
                    Η ανατροφοδότηση παρέχεται για σκοπούς εξάσκησης και αυτοβελτίωσης
                    και δεν αποτελεί επίσημη ή αντικειμενική αξιολόγηση επαγγελματικής καταλληλότητας.
                    Ενδέχεται να περιέχει ανακρίβειες, να παραλείπει σημαντικά στοιχεία ή να μην ανταποκρίνεται πλήρως στην απάντησή σας.
                    Αξιοποιήστε τις συμβουλές που θεωρείτε χρήσιμες· δεν είναι υποχρεωτικό να αναθεωρήσετε την απάντησή σας.
                </MudText>

            </MudAlert>

            @if (!studyInfo.Enabled)
            {
                <MudAlert Severity="Severity.Info">Η ερευνητική συλλογή δεν έχει ενεργοποιηθεί. Δεν καταγράφονται νέες συμμετοχές.</MudAlert>
            }
            else
            {
            <MudText Style="white-space: pre-wrap" Class="mb-4">@studyInfo.Text</MudText>
            <MudCheckBox T="bool" @bind-Value="consentAccepted" Label="Διάβασα την ενημέρωση και επιλέγω να συμμετάσχω." />
            <MudForm @ref="form">
                <MudTextField @bind-Value="nickname" Label="Ψευδώνυμο / Nickname" Required="true" RequiredError="Παρακαλούμε εισαγάγετε ψευδώνυμο." Validation="@(new Func<string, string?>(ValidateNickname))" Variant="Variant.Outlined" Class="mb-4" />
                
                <MudNumericField T="int?" @bind-Value="age" Label="Ηλικία" Required="true" RequiredError="Παρακαλούμε εισαγάγετε την ηλικία σας." Validation="@(new Func<int?, string?>(ValidateAge))" Variant="Variant.Outlined" Class="mb-4" />

                <MudSelect T="string" @bind-Value="gender" Label="Φύλο" Required="true" RequiredError="Παρακαλούμε επιλέξτε φύλο." Variant="Variant.Outlined" Class="mb-4">
                    <MudSelectItem Value="@("Male")">Άνδρας</MudSelectItem>
                    <MudSelectItem Value="@("Female")">Γυναίκα</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Άλλο / Προτιμώ να μην πω</MudSelectItem>
                </MudSelect>

                <MudSelect T="string" @bind-Value="aiFamiliarity" Label="Εξοικείωση με την Τεχνητή Νοημοσύνη (AI)" Required="true" RequiredError="Παρακαλούμε επιλέξτε το επίπεδο εξοικείωσής σας με την Τεχνητή Νοημοσύνη." Variant="Variant.Outlined" Class="mb-6">
                    <MudSelectItem Value="@("Low")">Χαμηλή</MudSelectItem>
                    <MudSelectItem Value="@("Medium")">Μεσαία</MudSelectItem>
                    <MudSelectItem Value="@("High")">Υψηλή</MudSelectItem>
                </MudSelect>
                
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" OnClick="StartInterview" Disabled="@(isLoading || !consentAccepted)" Style="border-radius: 8px; font-weight:600; text-transform:none; height: 50px;">
                    @if (isLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">Έναρξη...</MudText>
                    }
                    else
                    {
                        <MudText>Έναρξη Συνέντευξης</MudText>
                    }
                </MudButton>
            </MudForm>
            }
            @if (!string.IsNullOrWhiteSpace(enrollmentError)) { <MudAlert Severity="Severity.Error">@enrollmentError</MudAlert> }
        </MudCard>
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-4 mb-4 rounded-lg" Style="background-color: #f8fafc;">
            <div style="display:flex; justify-content:space-between; align-items:center;" class="mb-2">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #0f172a;">
                    Στάδιο @currentStage από 7
                </MudText>
            </div>
            <MudProgressLinear Color="Color.Primary" Value="@((currentStage / 7.0) * 100)" Class="rounded" Size="Size.Medium" />
        </MudPaper>

        <MudPaper Elevation="2" id="chat-container" Style="height: 500px; overflow-y: auto; padding: 20px; background-color: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0;">
            <div style="display: flex; flex-direction: column; gap: 16px;">
                @foreach (var msg in chatMessages)
                {
                    var isUser = msg.IsUser;
                    <div style="display: flex; justify-content: @(isUser ? "flex-end" : "flex-start"); gap: 10px;">
                        @if (!isUser)
                        {
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" />
                            </MudAvatar>
                        }

                        <div style="background-color: @(isUser ? "#2563eb" : "#f1f5f9"); 
                                    color: @(isUser ? "#ffffff" : "#0f172a"); 
                                    padding: 14px 18px; 
                                    border-radius: 16px; 
                                    max-width: 75%;
                                    min-width: 0;
                                    overflow-wrap: anywhere;
                                    font-size: 15px; 
                                    line-height: 1.6;
                                    box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                            <span style="font-weight: 700; display: block; margin-bottom: 4px; font-size: 11px; color: @(isUser ? "#bfdbfe" : "#64748b"); text-transform: uppercase;">
                                @(isUser ? nickname : "ΣΥΝΕΝΤΕΥΚΤΗΣ")
                            </span>
                            @msg.Text
                        </div>

                        @if (isUser)
                        {
                            <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            </MudAvatar>
                        }
                    </div>
                }

                @if (isBotTyping)
                {
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" />
                        </MudAvatar>
                        <MudText Typo="Typo.body2" Style="color: #64748b; font-style: italic;">
                            Ο συνεντεύκτης πληκτρολογεί...
                        </MudText>
                    </div>
                }
            </div>
        </MudPaper>

        <div class="interview-actions mt-4">
            @if (interviewState is InterviewUiState.PreQuestionnaires or InterviewUiState.PostQuestionnaires)
            {
                <StudyQuestionnaires SessionId="sessionId" Phase="@(interviewState == InterviewUiState.PreQuestionnaires ? "pre" : "post")" OnCompleted="GetNextQuestionFromApi" />
            }
            @if (interviewState == InterviewUiState.Answering)
            {
                <MudStack Spacing="2" Class="w-100">
                    <div id="original-answer-composer" class="answer-composer"
                         onkeydown="if (event.target.tagName === 'TEXTAREA' && event.key === 'Enter' && !event.shiftKey) event.preventDefault();">
                        <MudTextField @bind-Value="userInput"
                                      InputId="original-answer-input"
                                      Immediate="true"
                                      Label="Γράψτε την απάντησή σας..."
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Lines="3"
                                      Sizing="InputSizing.Fixed"
                                      Class="answer-composer__input"
                                      Disabled="@(isBotTyping || isAnswerSubmitting || pendingAnswerSubmission != null)"
                                      OnKeyDown="HandleKeyDown" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="answer-composer__send"
                                   OnClick="SendMessage"
                                   Disabled="@(string.IsNullOrWhiteSpace(userInput) || isBotTyping || isAnswerSubmitting || pendingAnswerSubmission != null)">
                            @if (isAnswerSubmitting)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Αποθήκευση...</MudText>
                            }
                            else
                            {
                                <MudText>Αποστολή</MudText>
                            }
                        </MudButton>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(answerSubmissionError))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            @answerSubmissionError
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       OnClick="RetryPendingAnswer"
                                       Disabled="@isAnswerSubmitting">
                                Δοκιμάστε ξανά
                            </MudButton>
                        </MudAlert>
                    }
                </MudStack>
            }
            @if (interviewState is (InterviewUiState.AwaitingFeedback or InterviewUiState.AwaitingRevisedFeedback) && !string.IsNullOrWhiteSpace(feedbackRetrievalError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    @feedbackRetrievalError
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               OnClick="RetryFeedback"
                               Disabled="@isBotTyping">
                        Επανάληψη ανάκτησης ανατροφοδότησης
                    </MudButton>
                </MudAlert>
            }
            @if (interviewState == InterviewUiState.WaitingForDecision)
            {
                <MudStack Spacing="2" Class="mt-4">

                    <MudText Typo="Typo.body2"
                             Align="Align.Center"
                             Style="color:#64748b;">
                        Αφού διαβάσετε την ανατροφοδότηση, επιλέξτε αν θέλετε
                        να βελτιώσετε την απάντησή σας ή να συνεχίσετε στην επόμενη ερώτηση.
                    </MudText>

                    <MudStack Row="true"
                              Spacing="2"
                              Justify="Justify.Center">

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="ChooseRevision"
                                   Disabled="@(isActionLoading || pendingDecision != null || awaitingDisplayAck)">
                            Βελτίωση απάντησης
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="ContinueWithoutRevision"
                                   Disabled="@(isActionLoading || pendingDecision != null || awaitingDisplayAck)">
                            @(currentStage == 7 ? "ΟΛΟΚΛΗΡΩΣΗ ΣΥΝΕΝΤΕΥΞΗΣ" : "ΣΥΝΕΧΕΙΑ ΣΤΗΝ ΕΠΟΜΕΝΗ ΕΡΩΤΗΣΗ")
                        </MudButton>

                    </MudStack>

                </MudStack>
            }
            
            @if (interviewState == InterviewUiState.WaitingForContinue)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="ContinueAfterRevisedFeedback" Disabled="@(isActionLoading || awaitingDisplayAck)">
                    Συνέχεια
                </MudButton>
            }
            @if (awaitingDisplayAck && !string.IsNullOrWhiteSpace(actionError))
            {
                <MudAlert Severity="Severity.Error">
                    @actionError
                    <MudButton OnClick="AcknowledgeDisplayedFeedback" Disabled="@isActionLoading">Επανάληψη επιβεβαίωσης εμφάνισης</MudButton>
                </MudAlert>
            }
            @if (flowVersion >= 2 && !string.IsNullOrWhiteSpace(feedbackRetrievalError) &&
                 interviewState is not (InterviewUiState.AwaitingFeedback or InterviewUiState.AwaitingRevisedFeedback))
            {
                <MudAlert Severity="Severity.Error">
                    @feedbackRetrievalError
                    <MudButton OnClick="GetNextQuestionFromApi" Disabled="@isBotTyping">Επανάληψη ανάκτησης</MudButton>
                </MudAlert>
            }
            @if (interviewState == InterviewUiState.Revising)
            {
                <MudStack id="revision-answer-composer" Spacing="2" Class="w-100"
                          onkeydown="if (event.target.tagName === 'TEXTAREA' && event.key === 'Enter' && !event.shiftKey) event.preventDefault();">

                    <MudText Typo="Typo.subtitle2" Style="color:#475569;">
                        Βελτιώστε την απάντησή σας με βάση το feedback που λάβατε.
                    </MudText>

                    <MudTextField @bind-Value="userInput"
                                  InputId="revision-answer-input"
                                  Immediate="true"
                                  Label="Βελτιωμένη απάντηση"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Lines="4"
                                  Disabled="@(isActionLoading || pendingRevisionText != null)"
                                  OnKeyDown="HandleRevisionKeyDown" />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SubmitRevision"
                               Disabled="@(string.IsNullOrWhiteSpace(userInput) || isActionLoading || pendingRevisionText != null)">
                        Υποβολή βελτιωμένης απάντησης
                    </MudButton>

                </MudStack>
            }

            @if (!awaitingDisplayAck && !string.IsNullOrWhiteSpace(actionError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    @actionError
                    <MudButton Variant="Variant.Text" Color="Color.Error"
                               OnClick="RetryAnswerAction" Disabled="@isActionLoading">
                        Επανάληψη της ίδιας ενέργειας
                    </MudButton>
                </MudAlert>
            }

            @if (interviewState == InterviewUiState.Finished)
            {
                <MudAlert Severity="Severity.Success"
                          Variant="Variant.Filled"
                          Class="w-100"
                          Style="border-radius: 8px;">
                    🎉 Η προσομοίωση συνέντευξης ολοκληρώθηκε!
                    Σας ευχαριστούμε θερμά για τη συμμετοχή σας.
                </MudAlert>
            }
        </div>
    }

    @if (secureAccessAvailable)
    {
        <MudButton OnClick="EndParticipantAccess" Variant="Variant.Text">Τερματισμός πρόσβασης</MudButton>
    }
</MudContainer>

@code {
    private const string ApiBaseUrl = "api/Interview";

    private MudForm form = null!;
    private bool isLoading = false;
    private bool isActionLoading = false;
    private bool isAnswerSubmitting = false;

    private string nickname = "";
    private int? age;
    private string? gender;
    private string? aiFamiliarity;
    private string selectedCondition = "A";

    private bool isSessionStarted = false;
    private int userId;
    private Guid sessionId;
    private int flowVersion;
    private bool secureAccessAvailable;
    private bool consentAccepted;
    private string? enrollmentError;
    private StudyView studyInfo = new();
    private sealed class StudyView
    {
        public StudyView() { }
        public bool Enabled { get; set; }
        public bool SignedIn { get; set; }
        public bool TestMode { get; set; }
        public string Text { get; set; } = "";
        public string Version { get; set; } = "";
        public string TextHash { get; set; } = "";
    }
    private sealed class ParticipantProfile
    {
        public ParticipantProfile() { }
        public int UserId { get; set; }
        public string Nickname { get; set; } = "";
        public Guid? SessionId { get; set; }
        public string? Condition { get; set; }
        public int? FlowVersion { get; set; }
    }
    private bool restoringSession;
    private bool browserTimingsUnavailable;
    private sealed class StoredSession
    {
        public StoredSession() { }
        public Guid Id { get; set; }
        public int FlowVersion { get; set; }
        public string Condition { get; set; } = "";
        public string Nickname { get; set; } = "";
    }
    private string TimingKey => $"{sessionId}:{currentStage}";
    private BrowserTiming? questionBrowserTiming;
    private BrowserTiming? pendingDecisionTiming;
    private BrowserTiming? pendingRevisionTiming;
    private BrowserTiming? pendingContinueTiming;
    private BrowserTiming? pendingDisplayTiming;
    private int pendingDisplayRound;
    private bool awaitingDisplayAck;
    private bool continuePending;
    private (int Stage, InterviewUiState State)? lastTimedPhase;
    private sealed class BrowserTiming
    {
        public BrowserTiming() { }
        public DateTime? BrowserOccurredAt { get; set; }
        public double? ElapsedMilliseconds { get; set; }
        public double? WaitMilliseconds { get; set; }
        public double? StageElapsedMilliseconds { get; set; }
    }

    private int currentStage = 1;
    private string currentQuestionText = "";

    private string userInput = "";
    private bool isBotTyping = false;
    private List<ChatMessage> chatMessages = new();

    private Stopwatch latencyStopwatch = new();
    
    private int currentAnswerId;
    
    private enum InterviewUiState
    {
        Answering,
        LoadingNextQuestion,
        AwaitingFeedback,
        AwaitingRevisedFeedback,
        WaitingForContinue,
        PreQuestionnaires,
        PostQuestionnaires,
        WaitingForDecision,
        Revising,
        Finished
    }

    private InterviewUiState interviewState =
        InterviewUiState.Answering;

    private QuestionResponseDto? pendingQuestion;

    private string originalAnswerText = "";
    private DateTime currentQuestionShownAt;
    private PendingAnswerSubmission? pendingAnswerSubmission;
    private string? answerSubmissionError;
    private string? feedbackRetrievalError;
    private bool? pendingDecision;
    private string? pendingRevisionText;
    private string? actionError;

    private sealed record PendingAnswerSubmission(
        Guid SubmissionId,
        Guid SessionId,
        int StageNumber,
        string StageName,
        string QuestionText,
        string AnswerText,
        DateTime QuestionShownAt,
        DateTime OriginalAnswerSubmittedAt,
        BrowserTiming? Timing = null,
        DateTime? QuestionBrowserDisplayedAt = null);

    private async Task StartInterview()
    {
        if (isLoading || !studyInfo.Enabled || !consentAccepted) return;
        isLoading = true;
        enrollmentError = null;
        try
        {
            await form.ValidateAsync();
            if (!form.IsValid || !IsAgeWithinAllowedRange(age)) return;
            await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/interview-chat.js?v=5");
            var registered = await module.InvokeAsync<bool>("registerParticipant", new
            {
                nickname = nickname.Trim(), age = age!.Value, gender, aiFamiliarityLevel = aiFamiliarity,
                consentAccepted, consentVersion = studyInfo.Version, consentTextHash = studyInfo.TextHash
            });
            if (!registered) enrollmentError = "Η εγγραφή δεν ολοκληρώθηκε. Ελέγξτε την ενημέρωση/συναίνεση και δοκιμάστε ξανά.";
        }
        catch (Exception ex) when (ex is JSException or HttpRequestException or TaskCanceledException)
        { enrollmentError = "Η έναρξη δεν επιβεβαιώθηκε. Δοκιμάστε ξανά την ανάκτηση της σελίδας."; }
        finally { isLoading = false; StateHasChanged(); }
    }

    private static string? ValidateNickname(string value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Παρακαλούμε εισαγάγετε ψευδώνυμο."
            : null;
    }

    private static string? ValidateAge(int? value)
    {
        if (!value.HasValue)
        {
            return "Παρακαλούμε εισαγάγετε την ηλικία σας.";
        }

        return IsAgeWithinAllowedRange(value)
            ? null
            : "Η ηλικία πρέπει να είναι από 18 έως 99 ετών.";
    }

    private static bool IsAgeWithinAllowedRange(int? value) =>
        value is >= 18 and <= 99;

    private async Task GetNextQuestionFromApi()
    {
        if (flowVersion >= 2)
        {
            await GetFlowV2();
            return;
        }
        if (isBotTyping)
            return;

        var awaitingFeedback = interviewState == InterviewUiState.AwaitingFeedback;
        feedbackRetrievalError = null;
        isBotTyping = true;
        StateHasChanged();

        try
        {
            var feedbackQuery = awaitingFeedback ? $"?answerId={currentAnswerId}" : "";
            var res = await Http.GetFromJsonAsync<QuestionResponseDto>(
                $"{ApiBaseUrl}/sessions/{sessionId}/next-question{feedbackQuery}");

            if (res == null || (awaitingFeedback &&
                (res.AnswerId != currentAnswerId || res.FeedbackStatus != "Success" ||
                 !AIInterviewSimulator.Engine.Feedback.FeedbackResult.IsUsable(res.Feedback))))
                throw new InvalidOperationException("The response did not contain the expected feedback.");

            if (res.IsFinished)
            {
                interviewState = InterviewUiState.Finished;
                return;
            }

            if (string.IsNullOrWhiteSpace(res.Feedback))
            {
                if (res.FeedbackStatus != "NotRequired" || string.IsNullOrWhiteSpace(res.QuestionText))
                    throw new InvalidOperationException("The response did not contain a valid initial question.");
                ShowQuestion(res);
                return;
            }

            chatMessages.Add(new ChatMessage
            {
                Text = res.Feedback,
                IsUser = false
            });

            pendingQuestion = res;

            interviewState = InterviewUiState.WaitingForDecision;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching question: {ex.Message}");
            if (awaitingFeedback)
            {
                feedbackRetrievalError =
                    "Η απάντησή σας έχει αποθηκευτεί. Λόγω τεχνικού προβλήματος, η ανατροφοδότηση δεν είναι διαθέσιμη. Δοκιμάστε ξανά την ανάκτησή της· η απάντησή σας δεν θα υποβληθεί εκ νέου.";
            }
        }
        finally
        {
            isBotTyping = false;
            StateHasChanged();
        }
    }

    private Task RetryFeedback() =>
        interviewState is InterviewUiState.AwaitingFeedback or InterviewUiState.AwaitingRevisedFeedback
            ? GetNextQuestionFromApi()
            : Task.CompletedTask;
    
    private void ShowQuestion(QuestionResponseDto question)
    {
        currentStage = question.StageNumber;
        questionBrowserTiming = null;
        browserTimingsUnavailable = false;
        lastTimedPhase = null;
        currentQuestionText = question.QuestionText;
        currentQuestionShownAt = DateTime.UtcNow;
        
        chatMessages.Add(new ChatMessage
        {
            Text = question.QuestionText,
            IsUser = false
        });

        latencyStopwatch.Restart();

        interviewState = InterviewUiState.Answering;
    }

    private async Task SendMessage()
    {
        if (interviewState != InterviewUiState.Answering ||
            string.IsNullOrWhiteSpace(userInput) ||
            isBotTyping ||
            isAnswerSubmitting ||
            pendingAnswerSubmission != null)
        {
            return;
        }

        latencyStopwatch.Stop();

        BrowserTiming? submissionTiming = null;
        if (flowVersion >= 2)
        {
            isAnswerSubmitting = true;
            submissionTiming = await CaptureBrowserTiming("submit");
            isAnswerSubmitting = false;
        }
        pendingAnswerSubmission = new PendingAnswerSubmission(
            Guid.NewGuid(),
            sessionId,
            currentStage,
            GetStageName(currentStage),
            currentQuestionText,
            userInput,
            currentQuestionShownAt,
            DateTime.UtcNow,
            submissionTiming,
            questionBrowserTiming?.BrowserOccurredAt);

        await PersistPendingAnswer();
    }

    private Task RetryPendingAnswer()
    {
        return PersistPendingAnswer();
    }

    private async Task PersistPendingAnswer()
    {
        if (pendingAnswerSubmission == null || isAnswerSubmitting)
        {
            return;
        }

        var submission = pendingAnswerSubmission;
        var savedSuccessfully = false;

        isAnswerSubmitting = true;
        answerSubmissionError = null;
        StateHasChanged();

        try
        {
            var answerResponse = await Http.PostAsJsonAsync(
                $"{ApiBaseUrl}/answers",
                submission);

            answerResponse.EnsureSuccessStatusCode();

            var savedAnswer = await answerResponse.Content
                .ReadFromJsonAsync<AnswerResponseDto>();

            if (savedAnswer == null || savedAnswer.AnswerId <= 0)
            {
                throw new InvalidOperationException(
                    "The answer response did not contain an answer ID.");
            }

            currentAnswerId = savedAnswer.AnswerId;
            interviewState = InterviewUiState.AwaitingFeedback;
            originalAnswerText = submission.AnswerText;

            chatMessages.Add(new ChatMessage
            {
                Text = submission.AnswerText,
                IsUser = true
            });

            userInput = "";
            pendingAnswerSubmission = null;
            answerSubmissionError = null;
            savedSuccessfully = true;
        }
        catch (Exception)
        {
            answerSubmissionError =
                "Η απάντησή σας δεν αποθηκεύτηκε. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά.";
        }
        finally
        {
            isAnswerSubmitting = false;
            StateHasChanged();
        }

        if (savedSuccessfully)
        {
            await GetNextQuestionFromApi();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" &&
            !e.ShiftKey &&
            !e.Repeat &&
            !string.IsNullOrWhiteSpace(userInput) &&
            !isBotTyping &&
            !isActionLoading &&
            !isAnswerSubmitting &&
            pendingAnswerSubmission == null)
        {
            await SendMessage();
        }
    }

    private async Task HandleRevisionKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !e.Repeat && pendingRevisionText == null)
        {
            await SubmitRevision();
        }
    }

    private int lastScrolledMessageCount;
    private (int Stage, InterviewUiState State)? lastFocusedAnswer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await RestoreBrowserSession();
        if (flowVersion >= 2) await RecordRenderedPhase();
        // Event handlers can finish before the browser receives the render batch.
        // Scroll only after a batch containing a new message has been rendered.
        var shouldScroll = chatMessages.Count > 0 && chatMessages.Count != lastScrolledMessageCount;
        var focusTarget = (Stage: currentStage, State: interviewState);
        var canFocus = isSessionStarted && !string.IsNullOrWhiteSpace(currentQuestionText) &&
            !isBotTyping && !isAnswerSubmitting && !isActionLoading &&
            pendingAnswerSubmission == null && pendingRevisionText == null &&
            interviewState is InterviewUiState.Answering or InterviewUiState.Revising;
        var shouldFocus = canFocus && lastFocusedAnswer != focusTarget;
        if (!shouldScroll && !shouldFocus)
            return;

        if (shouldScroll)
            lastScrolledMessageCount = chatMessages.Count;
        try
        {
            await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./js/interview-chat.js?v=5");
            if (shouldScroll)
                await module.InvokeVoidAsync("scrollToLatestMessage", "chat-container");
            // Interop awaits can overlap another event/render. Recheck before focusing.
            if (shouldFocus && lastFocusedAnswer != focusTarget &&
                focusTarget == (currentStage, interviewState) &&
                !isBotTyping && !isAnswerSubmitting && !isActionLoading &&
                pendingAnswerSubmission == null && pendingRevisionText == null)
            {
                var focused = await module.InvokeAsync<bool>("focusAnswer",
                    focusTarget.State == InterviewUiState.Answering
                        ? "original-answer-input" : "revision-answer-input");
                // A failed attempt stays eligible for the next normal render.
                if (focused)
                    lastFocusedAnswer = focusTarget;
            }
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException)
        {
            Console.WriteLine($"Error updating chat scroll/focus: {ex.Message}");
        }
    }

    private static string GetStageName(int stageNumber)
    {
        return stageNumber switch
        {
            1 => "Αυτοπαρουσίαση και πρώτη εντύπωση",
            2 => "Κίνητρα και ενδιαφέρον για τη θέση",
            3 => "Επίλυση προβλημάτων",
            4 => "Συνεργασία και ομαδικότητα",
            5 => "Διαχείριση δύσκολων καταστάσεων",
            6 => "Προσαρμοστικότητα και μάθηση",
            7 => "Επαγγελματικοί στόχοι και εξέλιξη",
            _ => "Άγνωστο στάδιο"
        };
    }
    
    private async Task ChooseRevision()
    {
        if (isActionLoading || interviewState != InterviewUiState.WaitingForDecision ||
            (pendingDecision.HasValue && pendingDecision != true) ||
            currentAnswerId <= 0 || pendingQuestion == null)
            return;

        if (awaitingDisplayAck) return;
        pendingDecision ??= true;
        actionError = null;
        isActionLoading = true;
        try
        {
            if (flowVersion >= 2) pendingDecisionTiming ??= await CaptureBrowserTiming("decision");
            var decisionRequest = new
            {
                timing = pendingDecisionTiming,
                choseToRevise = true
            };

            var response = await Http.PutAsJsonAsync(
                $"{ApiBaseUrl}/answers/{currentAnswerId}/decision",
                decisionRequest);

            response.EnsureSuccessStatusCode();
            pendingDecision = null;
            pendingDecisionTiming = null;

            userInput = originalAnswerText;
            interviewState = InterviewUiState.Revising;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            actionError = "Δεν μπορέσαμε να επιβεβαιώσουμε την αποθήκευση της επιλογής σας. Δοκιμάστε ξανά την ίδια ενέργεια.";
            Console.WriteLine($"Error choosing revision: {ex.Message}");
        }
        finally
        {
            isActionLoading = false;
            StateHasChanged();
        }
    }

    private async Task ContinueWithoutRevision()
    {
        if (isActionLoading || interviewState != InterviewUiState.WaitingForDecision ||
            (pendingDecision.HasValue && pendingDecision != false) ||
            currentAnswerId <= 0 || pendingQuestion == null)
            return;

        if (awaitingDisplayAck) return;
        pendingDecision ??= false;
        actionError = null;
        isActionLoading = true;
        try
        {
            if (flowVersion >= 2) pendingDecisionTiming ??= await CaptureBrowserTiming("decision");
            var decisionRequest = new
            {
                timing = pendingDecisionTiming,
                choseToRevise = false
            };

            var response = await Http.PutAsJsonAsync(
                $"{ApiBaseUrl}/answers/{currentAnswerId}/decision",
                decisionRequest);

            response.EnsureSuccessStatusCode();
            pendingDecision = null;
            pendingDecisionTiming = null;
            if (flowVersion >= 2)
            {
                pendingQuestion = null;
                interviewState = InterviewUiState.LoadingNextQuestion;
                await GetNextQuestionFromApi();
                return;
            }

            var nextQuestion = pendingQuestion;
            pendingQuestion = null;

            if (nextQuestion != null && !string.IsNullOrWhiteSpace(nextQuestion.QuestionText))
            {
                ShowQuestion(nextQuestion);
            }
            else
            {
                interviewState = InterviewUiState.Finished;
            }


        }
        catch (Exception ex)
        {
            actionError = "Δεν μπορέσαμε να επιβεβαιώσουμε την αποθήκευση της επιλογής σας. Δοκιμάστε ξανά την ίδια ενέργεια.";
            Console.WriteLine($"Error saving decision: {ex.Message}");
        }
        finally
        {
            isActionLoading = false;
            StateHasChanged();
        }
    }
    
    private async Task SubmitRevision()
    {
        if (isActionLoading || interviewState != InterviewUiState.Revising || currentAnswerId <= 0 ||
            pendingQuestion == null ||
            string.IsNullOrWhiteSpace(pendingRevisionText ?? userInput))
        {
            return;
        }

        pendingRevisionText ??= userInput.Trim();
        actionError = null;
        isActionLoading = true;
        try
        {
            var revisedText = pendingRevisionText;

            if (flowVersion >= 2) pendingRevisionTiming ??= await CaptureBrowserTiming("revision");
            var revisionRequest = new
            {
                timing = pendingRevisionTiming,
                revisedAnswerText = revisedText
            };

            var response = await Http.PutAsJsonAsync(
                $"{ApiBaseUrl}/answers/{currentAnswerId}/revision",
                revisionRequest);

            response.EnsureSuccessStatusCode();
            pendingRevisionText = null;

            chatMessages.Add(new ChatMessage
            {
                Text = revisedText,
                IsUser = true
            });

            userInput = "";
            if (flowVersion >= 2)
            {
                pendingRevisionTiming = null;
                interviewState = InterviewUiState.AwaitingRevisedFeedback;
                await GetNextQuestionFromApi();
                return;
            }

            var nextQuestion = pendingQuestion;
            pendingQuestion = null;

            if (nextQuestion != null && !string.IsNullOrWhiteSpace(nextQuestion.QuestionText))
            {
                ShowQuestion(nextQuestion);
            }
            else
            {
                interviewState = InterviewUiState.Finished;
            }


        }
        catch (Exception ex)
        {
            actionError = "Δεν μπορέσαμε να επιβεβαιώσουμε την αποθήκευση της αναθεωρημένης απάντησής σας. Δοκιμάστε ξανά· θα σταλεί το ίδιο κείμενο.";
            Console.WriteLine($"Error submitting revision: {ex.Message}");
        }
        finally
        {
            isActionLoading = false;
            StateHasChanged();
        }
    }

    private Task RetryAnswerAction() => pendingDecision.HasValue
        ? (pendingDecision.Value ? ChooseRevision() : ContinueWithoutRevision())
        : pendingRevisionText != null ? SubmitRevision()
        : continuePending ? ContinueAfterRevisedFeedback() : Task.CompletedTask;


    private readonly HashSet<string> displayedFeedback = new();

    private async Task<BrowserTiming?> CaptureBrowserTiming(string eventName)
    {
        if (browserTimingsUnavailable) return null;
        try
        {
            await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/interview-chat.js?v=5");
            return module == null ? null : await module.InvokeAsync<BrowserTiming?>("captureTiming", TimingKey, eventName);
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException or InvalidOperationException)
        {
            return null; // Browser observations stay null; no invented timing.
        }
    }

    private async Task<BrowserTiming?> MarkBrowserPhase(string phase)
    {
        if (browserTimingsUnavailable) return null;
        try
        {
            await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/interview-chat.js?v=5");
            return module == null ? null : await module.InvokeAsync<BrowserTiming?>("markPhase", TimingKey, phase);
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException or InvalidOperationException)
        {
            return null;
        }
    }

    private async Task RecordRenderedPhase()
    {
        var phase = (Stage: currentStage, State: interviewState);
        if (restoringSession || !isSessionStarted || isActionLoading || isBotTyping || isAnswerSubmitting || lastTimedPhase == phase ||
            interviewState is not (InterviewUiState.Answering or InterviewUiState.Revising or
                InterviewUiState.WaitingForDecision or InterviewUiState.WaitingForContinue)) return;
        lastTimedPhase = phase;
        if (interviewState == InterviewUiState.Answering)
            questionBrowserTiming = await MarkBrowserPhase("question");
        else if (interviewState == InterviewUiState.Revising)
        {
            var timing = await MarkBrowserPhase("revision") ?? new BrowserTiming();
            try
            {
                var response = await Http.PutAsJsonAsync($"{ApiBaseUrl}/answers/{currentAnswerId}/revision-editor/shown", timing);
                response.EnsureSuccessStatusCode();
            }
            catch (HttpRequestException) { /* Optional observation; do not block saved work. */ }
        }
        else
        {
            var round = interviewState == InterviewUiState.WaitingForContinue ? 2 : 1;
            pendingDisplayTiming ??= await MarkBrowserPhase($"feedback{round}") ?? new BrowserTiming();
            pendingDisplayRound = round;
            await AcknowledgeDisplayedFeedback();
        }
    }

    private async Task AcknowledgeDisplayedFeedback()
    {
        if (!awaitingDisplayAck || isActionLoading) return;
        isActionLoading = true;
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"{ApiBaseUrl}/answers/{currentAnswerId}/feedback/{pendingDisplayRound}/shown",
                pendingDisplayTiming ?? new BrowserTiming());
            response.EnsureSuccessStatusCode();
            awaitingDisplayAck = false;
            pendingDisplayTiming = null;
            actionError = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            actionError = "Η ανατροφοδότηση εμφανίστηκε, αλλά δεν επιβεβαιώθηκε η εμφάνισή της στον server. Δοκιμάστε ξανά.";
        }
        finally { isActionLoading = false; StateHasChanged(); }
    }

    private async Task GetFlowV2()
    {
        if (isBotTyping) return;
        isBotTyping = true;
        feedbackRetrievalError = null;
        StateHasChanged();
        try
        {
            QuestionResponseDto? res;
            if (interviewState is InterviewUiState.AwaitingFeedback or InterviewUiState.AwaitingRevisedFeedback)
            {
                var round = interviewState == InterviewUiState.AwaitingRevisedFeedback ? 2 : 1;
                var response = await Http.PostAsync($"{ApiBaseUrl}/answers/{currentAnswerId}/feedback/{round}", null);
                response.EnsureSuccessStatusCode();
                res = await response.Content.ReadFromJsonAsync<QuestionResponseDto>();
                if (res?.AnswerId != currentAnswerId || res.Round != round || res.FeedbackStatus != "Success" ||
                    !AIInterviewSimulator.Engine.Feedback.FeedbackResult.IsUsable(res.Feedback))
                    throw new InvalidOperationException("Feedback is unavailable or still in progress.");
            }
            else
            {
                res = await Http.GetFromJsonAsync<QuestionResponseDto>($"{ApiBaseUrl}/sessions/{sessionId}/next-question");
            }
            if (res == null || res.FlowVersion != 2) throw new InvalidOperationException("Invalid flow response.");
            if (res.IsFinished)
            {
                interviewState = InterviewUiState.Finished;
                return;
            }
            if (res.FlowState is "PreQuestionnaires" or "PostQuestionnaires")
            {
                currentStage = res.StageNumber;
                interviewState = res.FlowState == "PreQuestionnaires" ? InterviewUiState.PreQuestionnaires : InterviewUiState.PostQuestionnaires;
                return;
            }
            if (res.FlowState == "Answering")
            {
                ShowQuestion(res);
                return;
            }
            currentAnswerId = res.AnswerId ?? throw new InvalidOperationException("Missing answer ID.");
            currentStage = res.StageNumber;
            currentQuestionText = res.QuestionText;
            originalAnswerText = res.AnswerText ?? originalAnswerText;
            if (chatMessages.Count == 0)
            {
                chatMessages.Add(new ChatMessage { Text = res.QuestionText, IsUser = false });
                chatMessages.Add(new ChatMessage { Text = originalAnswerText, IsUser = true });
                if (!string.IsNullOrWhiteSpace(res.RevisedAnswerText))
                    chatMessages.Add(new ChatMessage { Text = res.RevisedAnswerText, IsUser = true });
            }
            pendingQuestion = res; // compatibility with the existing editor/decision handlers
            if (res.FlowState == "Revising")
            {
                interviewState = InterviewUiState.Revising;
                userInput = originalAnswerText;
                if (!string.IsNullOrWhiteSpace(res.Feedback) && displayedFeedback.Add($"{currentAnswerId}:1"))
                    chatMessages.Add(new ChatMessage { Text = res.Feedback, IsUser = false });
                return;
            }
            if (res.FlowState is "AwaitingFeedback" or "AwaitingRevisedFeedback")
            {
                interviewState = res.Round == 2 ? InterviewUiState.AwaitingRevisedFeedback : InterviewUiState.AwaitingFeedback;
                feedbackRetrievalError = "Η απάντηση έχει αποθηκευτεί. Επιλέξτε ανάκτηση της ανατροφοδότησης.";
                return;
            }
            if (!AIInterviewSimulator.Engine.Feedback.FeedbackResult.IsUsable(res.Feedback))
                throw new InvalidOperationException("Missing feedback.");
            if (displayedFeedback.Add($"{currentAnswerId}:{res.Round}"))
                chatMessages.Add(new ChatMessage
                {
                    Text = (res.Round == 2 ? "Ανατροφοδότηση αναθεωρημένης απάντησης:\n" : "") + res.Feedback,
                    IsUser = false
                });
            interviewState = res.Round == 2 ? InterviewUiState.WaitingForContinue : InterviewUiState.WaitingForDecision;
            pendingDisplayRound = res.Round;
            pendingDisplayTiming = null;
            awaitingDisplayAck = true;
            lastTimedPhase = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException or System.Text.Json.JsonException)
        {
            feedbackRetrievalError = "Τα αποθηκευμένα δεδομένα διατηρούνται. Η ανάκτηση δεν ολοκληρώθηκε ή η παραγωγή βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά την ανάκτηση.";
        }
        finally { isBotTyping = false; StateHasChanged(); }
    }

    private async Task ContinueAfterRevisedFeedback()
    {
        if (flowVersion < 2 || isActionLoading || awaitingDisplayAck || interviewState != InterviewUiState.WaitingForContinue) return;
        continuePending = true;
        isActionLoading = true;
        actionError = null;
        try
        {
            pendingContinueTiming ??= await CaptureBrowserTiming("continue") ?? new BrowserTiming();
            var response = await Http.PutAsJsonAsync($"{ApiBaseUrl}/answers/{currentAnswerId}/continue", pendingContinueTiming);
            response.EnsureSuccessStatusCode();
            continuePending = false;
            pendingContinueTiming = null;
            pendingQuestion = null;
            interviewState = InterviewUiState.LoadingNextQuestion;
            await GetNextQuestionFromApi();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            actionError = "Δεν επιβεβαιώθηκε η συνέχεια. Δοκιμάστε ξανά την ίδια ενέργεια.";
        }
        finally { isActionLoading = false; StateHasChanged(); }
    }

    private async Task StoreBrowserSession()
    {
        try
        {
            await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/interview-chat.js?v=5");
            if (module != null) await module.InvokeVoidAsync("storeSession", new StoredSession
                { Id = sessionId, FlowVersion = flowVersion, Condition = selectedCondition, Nickname = nickname });
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException or InvalidOperationException) { }
    }

    private async Task RestoreBrowserSession()
    {
        if (isSessionStarted) return;
        restoringSession = true;
        try
        {
            await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/interview-chat.js?v=5");
            studyInfo = module == null ? new() : await module.InvokeAsync<StudyView?>("loadStudy") ?? new();
            using var response = await Http.GetAsync($"{ApiBaseUrl}/participant");
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                secureAccessAvailable = studyInfo.SignedIn;
                if (secureAccessAvailable) enrollmentError = "Η πρόσβαση έληξε ή ανακλήθηκε. Επιλέξτε λήξη πρόσβασης για να καθαριστεί η παλιά συνεδρία από τον browser.";
                return;
            }
            response.EnsureSuccessStatusCode();
            var saved = await response.Content.ReadFromJsonAsync<ParticipantProfile>();
            if (saved == null) return;
            secureAccessAvailable = true;
            userId = saved.UserId; nickname = saved.Nickname;
            if (saved.SessionId == null)
            {
                using var started = await Http.PostAsJsonAsync($"{ApiBaseUrl}/sessions", new { userId });
                started.EnsureSuccessStatusCode();
                var session = await started.Content.ReadFromJsonAsync<SessionDto>();
                if (session == null) return;
                sessionId = session.Id; flowVersion = session.FlowVersion; selectedCondition = session.Condition;
            }
            else
            {
                sessionId = saved.SessionId.Value; flowVersion = saved.FlowVersion ?? 2;
                selectedCondition = saved.Condition ?? "";
            }
            isSessionStarted = true;
            browserTimingsUnavailable = true;
            interviewState = InterviewUiState.LoadingNextQuestion;
            await GetNextQuestionFromApi();
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException or InvalidOperationException or HttpRequestException)
        { enrollmentError = "Η ασφαλής επαναφορά δεν ολοκληρώθηκε. Ανανεώστε τη σελίδα· μην δημιουργήσετε νέα συμμετοχή."; }
        finally { restoringSession = false; StateHasChanged(); }
    }

    private async Task EndParticipantAccess()
    {
        await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/interview-chat.js?v=5");
        if (!await module.InvokeAsync<bool>("revokeParticipant"))
            actionError = "Δεν επιβεβαιώθηκε η λήξη πρόσβασης. Δοκιμάστε ξανά.";
    }

