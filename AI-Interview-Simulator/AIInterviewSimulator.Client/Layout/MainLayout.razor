@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="_haxTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Color="Color.Surface" Fixed="true" Elevation="0" Style="border-bottom: 1px solid #e0e0e0;">
        <MudIcon Icon="@Icons.Material.Filled.Forum" Color="Color.Primary" Class="mr-3" />
        <MudText Typo="Typo.h6" Style="font-weight: 600; color: #111111;">Interview Simulator</MudText>
    </MudAppBar>
    
    <MudMainContent Class="pt-16" Style="background-color: #f3f4f6; min-height: 100vh;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private MudTheme _haxTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#0067b8",
            Secondary = "#2b579a",
            Background = "#f3f4f6",
            AppbarBackground = "#ffffff",
            Surface = "#ffffff",
            TextPrimary = "#242424",
            TextSecondary = "#5c5c5c"
        }
    };
}